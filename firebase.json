{
  "hosting": [
    {
      "target": "gestion",
      "public": "frontend/dist",
      "ignore": ["firebase.json", ".firebaserc", ".git/**", ".git", ".gitignore", "**/.*"],
      "rewrites": [
        { "source": "/api/**", "run": { "serviceId": "dc-plataforma-api", "region": "us-central1" } },
        { "source": "**", "destination": "/index.html" }
      ],
      "headers": [
        {
          "source": "/assets/**",
          "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
        },
        {
          "source": "/{index.html,sw.js}",
          "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
        }
      ]
    },
    {
      "target": "kiosko",
      "public": "kiosko",
      "ignore": ["firebase.json", ".firebaserc", ".git/**", ".git", ".gitignore", "**/.*"],
      "rewrites": [
        { "source": "/api/**", "run": { "serviceId": "dc-plataforma-api", "region": "us-central1" } }
      ],
      "headers": [
        {
          "source": "/",
          "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
        },
        {
          "source": "/index.html",
          "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
        }
      ]
    }
  ]
}
