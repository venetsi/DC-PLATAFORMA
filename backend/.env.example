# Base de datos (Google Cloud SQL via Cloud SQL Auth Proxy en local)
DATABASE_URL="postgresql://dc_plataforma_app:PASSWORD@localhost:5432/dc_plataforma?schema=public"

# JWT propio de esta plataforma (nunca compartido con dcsmart)
JWT_SECRET=cambiar_por_secreto_seguro
JWT_EXPIRES_IN=7d

# SSO con dcsmart (Fase 8 — hasta entonces no se usa)
INTERNAL_SHARED_SECRET=

# Login temporal de desarrollo (Fase 2-7, se reemplaza por el ticket SSO real en Fase 8)
# NUNCA poner en true en un ambiente accesible públicamente.
ALLOW_DEV_LOGIN=true

# Google Calendar API
GOOGLE_CALENDAR_SCOPE=https://www.googleapis.com/auth/calendar
# Solo en local dev: impersona esta service account desde tu propio `gcloud auth
# login` (necesita rol serviceAccountTokenCreator sobre ella). En Cloud Run se
# deja vacío -- ahí se usa directamente la identidad adjunta al servicio.
GOOGLE_IMPERSONATE_SERVICE_ACCOUNT=dc-plataforma-api@dc-smart-mvp.iam.gserviceaccount.com

# App
PORT=3100
NODE_ENV=development
FRONTEND_URL=http://localhost:5174
