generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// --- Cache de identidad de dcsmart (nunca fuente de verdad) ---

model ExtUser {
  id              String   @id
  email           String   @unique
  nombre          String
  id_departamento String?
  // Rol global super_admin/dcsmart, resuelto desde el ticket SSO (Fase 8).
  // Reemplaza el hardcode por email que usaba el login temporal de dev.
  es_admin_global Boolean  @default(false)
  // Identidad de Chat ("users/12345"), cacheada la primera vez que la persona
  // toca un boton: el payload de interaccion trae el email, pero el recurso
  // REST User de Chat no lo expone, asi que sin este cache habria que ir a
  // Directory API en cada click.
  chat_user_name  String?  @unique
  activo          Boolean  @default(true)
  synced_at       DateTime @default(now())

  @@map("ext_users")
}

model ExtLocal {
  id        String   @id
  nombre    String
  grupo     String?
  activo    Boolean  @default(true)
  synced_at DateTime @default(now())

  asignaciones TareaAsignacion[]

  @@map("ext_locales")
}

// --- Cache del catálogo Departamento de dcsmart + configuración propia
// (Calendar/Group/Chat/kiosko) que no tiene sentido guardar en dcsmart. ---

model Departamento {
  id                 String  @id
  nombre             String
  slug               String  @unique
  id_calendar_google String? @unique
  email_group_google String? @unique
  chat_webhook_url   String?
  // Space de Google Chat vinculado (formato "spaces/AAAA1234"). Se descubre
  // solo cuando agregan la app al Space (evento ADDED_TO_SPACE), no se carga a
  // mano. Si hay Space GANA el Space: chat_webhook_url queda como rollback si
  // la app falla, pero no se usa en paralelo -- si no, doble aviso.
  chat_space_name    String? @unique
  kiosko_key         String? @unique

  // Escalamiento (Fase A): dias HABILES de atraso a partir de los cuales se
  // avisa. NULL = usar el default global de entorno (AVISO_DIAS_DEPARTAMENTO /
  // AVISO_DIAS_DIRECCION). Nullable a proposito: la base es compartida con
  // produccion y db push no debe backfillear nada.
  dias_aviso_departamento Int?
  dias_aviso_direccion    Int?

  activo    Boolean  @default(true)
  synced_at DateTime @default(now())

  tareas                   Tarea[]
  cumplimiento             CumplimientoDiario[]
  asignaciones_compartidas TareaAsignacionDepto[]
  compartidoEnSpaces       DepartamentoCompartidoEnSpace[]
  repositoriosAsignados    RepositorioDepartamento[]

  @@map("departamentos")
}

// --- Repositorio de documentos para el comando /buscar del Chat App
// (Gemini File Search). Entidad con nombre propio (no un pool anonimo
// colgado de Departamento, como en la primera version) porque el usuario
// pidio explicitamente poder asignar un mismo repositorio a VARIOS
// departamentos -- "quiero del admin poder asignar los repos por
// multidepartamento, y cuando usan /buscar lea los repos asignados"
// (2026-09-19). La asignacion es un many-to-many simple via
// RepositorioDepartamento, SIN dueño (a diferencia de
// DepartamentoCompartidoEnSpace, que si distingue dueño de compartidos
// porque ahi importa quien recibe el recordatorio diario -- aca no hay
// ningun aviso automatico que dependa de "a quien pertenece").
//
// Un repositorio SIN ninguna fila en `departamentos` es general: lo ve
// cualquier Space, sin importar que departamento(s) cubra.
model Repositorio {
  id                       String          @id @default(uuid())
  nombre                   String
  tipo                     TipoRepositorio @default(MANUAL)
  // Solo para tipo DRIVE_FOLDER: id de la carpeta de Drive (no la URL
  // completa) de la que se importan los archivos. Null para MANUAL.
  drive_folder_id          String?
  // Ultima vez que se sincronizo la carpeta (boton "Resincronizar" en el
  // admin) -- null si nunca se corrio, o si es tipo MANUAL.
  ultimo_sync              DateTime?
  // Store de Gemini File Search de ESTE repositorio (ya no de un
  // departamento, ver comentario de arriba). Se crea perezoso en el primer
  // documento, mismo patron que id_calendar_google en asegurarDepartamento.
  gemini_file_search_store String?         @unique
  activo                   Boolean         @default(true)
  created_by               String
  created_at               DateTime        @default(now())
  updated_at               DateTime        @updatedAt

  documentos    RepositorioDocumento[]
  departamentos RepositorioDepartamento[]

  @@map("repositorios")
}

enum TipoRepositorio {
  MANUAL // documentos sueltos: subida de archivo o URL pegada
  DRIVE_FOLDER // toda una carpeta de Drive, importada con "Resincronizar"

  @@map("tipo_repositorio")
}

// --- Asignacion many-to-many entre Repositorio y Departamento. Sin fila
// para un repositorio = general (ver comentario en Repositorio). ---
model RepositorioDepartamento {
  id              String   @id @default(uuid())
  id_repositorio  String
  id_departamento String
  created_at      DateTime @default(now())

  repositorio  Repositorio  @relation(fields: [id_repositorio], references: [id])
  departamento Departamento @relation(fields: [id_departamento], references: [id])

  @@unique([id_repositorio, id_departamento])
  @@index([id_departamento])
  @@map("repositorio_departamentos")
}

// --- Documento indexado en Gemini File Search dentro de un Repositorio.
//
// El indexado en Gemini es ASINCRONICO (uploadToFileSearchStore devuelve una
// Operation de larga duracion, no exito/error en el momento) -- por eso
// `estado` existe: la fila nace PENDIENTE y un polling en background la pasa
// a INDEXADO (con gemini_file_id resuelto) o ERROR. Sin este campo, un
// documento recien subido "no aparece" en /buscar por un rato y parece un
// bug, no un estado transitorio real.
model RepositorioDocumento {
  id               String        @id @default(uuid())
  id_repositorio   String
  tipo             TipoDocumento
  // Se usa como displayName al subir a Gemini -> aparece tal cual en las
  // citas de /buscar, por eso importa que sea legible (no un uuid).
  nombre           String
  // URL pegada (tipo URL), o id de archivo de Drive (tipos DRIVE_*). Null
  // para archivos subidos directo (TXT/MD/PDF). Para DRIVE_*, ademas sirve
  // para no reimportar el mismo archivo dos veces al resincronizar la
  // carpeta (ver sincronizarCarpetaDrive en lib/repositorios.js).
  origen           String?
  gemini_file_id   String?
  gemini_operacion String?
  estado           String        @default("PENDIENTE") // PENDIENTE | INDEXADO | ERROR
  error            String?
  created_by       String
  created_at       DateTime      @default(now())
  updated_at       DateTime      @updatedAt

  repositorio Repositorio @relation(fields: [id_repositorio], references: [id])

  @@index([id_repositorio])
  @@index([estado])
  @@map("repositorio_documentos")
}

enum TipoDocumento {
  TXT
  MD
  PDF
  URL
  DRIVE_DOC
  DRIVE_SHEET
  DRIVE_SLIDE

  @@map("tipo_documento")
}

// --- Un Space de Chat puede cubrir MAS de un departamento, ademas del dueño
// (chat_space_name, arriba). Caso real: hay Spaces armados con gente de mas
// de un equipo (ej. "Administracion + Finanzas") que quieren coordinar
// tareas de los dos sin que cada uno tenga que escribir desde el Space del
// otro. Mismo patron que TareaAsignacionDepto ("comparte con departamentos
// adicionales, ademas del dueño"), aplicado a nivel Space en vez de a nivel
// asignacion.
//
// `chat_space_name` es un string plano, NO una relacion al campo unico de
// Departamento -- evita una relacion doble (dueño por id, Space por
// chat_space_name) sobre el mismo modelo. La limpieza si el dueño se
// desvincula es explicita, en comandoDesvincular (chat-comandos.js), no una
// cascada del schema. ---
model DepartamentoCompartidoEnSpace {
  id              String   @id @default(uuid())
  chat_space_name String
  id_departamento String
  created_at      DateTime @default(now())

  departamento Departamento @relation(fields: [id_departamento], references: [id])

  @@unique([chat_space_name, id_departamento])
  @@index([chat_space_name])
  @@map("departamento_compartido_en_spaces")
}

// --- Catálogo de tipos de tarea ("TAREA -> DEPARTAMENTO" del ejemplo real) ---

model Tarea {
  id              String   @id @default(uuid())
  id_departamento String
  nombre          String   @unique
  descripcion     String?
  activa          Boolean  @default(true)
  created_at      DateTime @default(now())
  updated_at      DateTime @updatedAt

  departamento       Departamento      @relation(fields: [id_departamento], references: [id])
  asignaciones       TareaAsignacion[]
  seguimientosDePago PagoSeguimiento[]

  @@index([id_departamento, activa])
  @@map("tareas")
}

// --- Puntero tarea x local hacia Google Calendar. No guarda recurrencia ni
// estado -- eso vive 100% en el evento de Calendar. Existe solo para: (a)
// saber que combinaciones (tarea, local) estan planeadas aunque todavia no
// tengan agenda definida, y (b) resolver id_tarea/id_local_ext -> evento. ---

model TareaAsignacion {
  id                String   @id @default(uuid())
  id_tarea          String
  id_local_ext      String?
  id_calendar_event String?
  // Responsable nominal opcional (la columna USUARIO del Excel real): null =
  // la hace cualquiera del departamento, que es el caso por defecto. Se
  // guarda acá ademas de en extendedProperties.asignado_a del evento porque
  // el formulario de agenda necesita precargarlo -- leerlo de Calendar seria
  // una llamada por asignacion, y sin precargar, editar la recurrencia
  // borraria el responsable ya cargado.
  asignado_a        String?
  activa            Boolean  @default(true)
  created_at        DateTime @default(now())
  updated_at        DateTime @updatedAt

  tarea        Tarea                        @relation(fields: [id_tarea], references: [id])
  local        ExtLocal?                    @relation(fields: [id_local_ext], references: [id])
  compartidas  TareaAsignacionDepto[]
  dependencias TareaAsignacionDependencia[] @relation("dependencias")
  dependientes TareaAsignacionDependencia[] @relation("dependientes")

  // OJO: @@unique de abajo NO alcanza para alcance EMPRESA (id_local_ext
  // NULL) -- Postgres no trata dos NULL como iguales, asi que dos filas con
  // el mismo id_tarea y ambas NULL pasan el chequeo de Prisma pero NO
  // deberian existir. Confirmado como bug real: creo 3 asignaciones
  // "CMV sin local" duplicadas durante pruebas manuales. El indice unico
  // parcial que lo cierra de verdad esta agregado a mano en la migracion
  // (Prisma no puede expresar "WHERE id_local_ext IS NULL" en el schema):
  //   CREATE UNIQUE INDEX ux_tarea_asignaciones_empresa
  //     ON tarea_asignaciones (id_tarea) WHERE id_local_ext IS NULL;
  //   CREATE UNIQUE INDEX ux_tarea_asignaciones_local
  //     ON tarea_asignaciones (id_tarea, id_local_ext) WHERE id_local_ext IS NOT NULL;
  @@unique([id_tarea, id_local_ext])
  @@index([id_local_ext])
  @@map("tarea_asignaciones")
}

// --- Comparte una TareaAsignacion con departamento(s) adicionales, ademas
// del dueño de la Tarea (tarea.id_departamento). "Un solo evento visible
// para ambos deptos": mismo id_asignacion (el extendedProperty que ya
// enlaza estado en Calendar), pero cada Calendar necesita su propia copia
// fisica del evento porque un evento vive en un unico calendario -- por eso
// cada fila guarda su propio id_calendar_event. Marcar realizada/editar
// agenda/desactivar/eliminar se propaga a todas las filas de esta tabla
// ademas de la TareaAsignacion original, ver asignaciones.js. ---
model TareaAsignacionDepto {
  id                String   @id @default(uuid())
  id_asignacion     String
  id_departamento   String
  id_calendar_event String?
  created_at        DateTime @default(now())

  asignacion   TareaAsignacion @relation(fields: [id_asignacion], references: [id])
  departamento Departamento    @relation(fields: [id_departamento], references: [id])

  @@unique([id_asignacion, id_departamento])
  @@map("tarea_asignacion_deptos")
}

// --- Dependencia BLANDA entre asignaciones: avisa, NO bloquea (decision
// explicita del usuario). La instancia que espera muestra "espera a <X>"
// mientras el prerrequisito de la MISMA FECHA siga sin hacerse, y al marcar
// se devuelve un aviso -- pero la marca se aplica igual y queda asentada en
// el historial append-only de description.
//
// Es entre TareaAsignacion y no entre Tarea (el catalogo) porque Tarea.nombre
// es unico GLOBAL: "CMV" es una sola Tarea pero se asigna por local, asi que
// "cargar ventas de TIAMO espera al CMV de TIAMO" no se podria expresar a
// nivel catalogo -- se cumpliria con el CMV de cualquier local. Ademas,
// evaluar el prerrequisito exige resolver un calendario y un evento
// concretos, y eso solo lo da la asignacion.
//
// Lo tedioso de cargar pares se resuelve en la UI (un atajo que las crea para
// todas las asignaciones de una tarea, haciendo match por local), no en el
// modelo -- mismo criterio que id_grupo en POST /asignaciones. ---
model TareaAsignacionDependencia {
  id                         String   @id @default(uuid())
  id_asignacion              String // la que ESPERA
  id_asignacion_prerequisito String // la que tiene que estar hecha antes
  activa                     Boolean  @default(true)
  created_at                 DateTime @default(now())

  asignacion   TareaAsignacion @relation("dependencias", fields: [id_asignacion], references: [id])
  prerequisito TareaAsignacion @relation("dependientes", fields: [id_asignacion_prerequisito], references: [id])

  @@unique([id_asignacion, id_asignacion_prerequisito])
  @@index([id_asignacion_prerequisito])
  @@map("tarea_asignacion_dependencias")
}

model CumplimientoDiario {
  id                 String   @id @default(uuid())
  id_departamento    String
  // String vacio (no null) = fila agregada de todo el departamento. A
  // proposito NO nullable: Postgres no trata dos NULL como iguales en el
  // indice unico de abajo, asi que un NULL real dejaria que upsert() inserte
  // duplicados en vez de actualizar la fila existente en cada corrida del job.
  id_local_ext       String   @default("")
  fecha              DateTime @db.Date
  total_tareas       Int
  realizadas         Int
  vencidas_sin_hacer Int
  created_at         DateTime @default(now())

  departamento Departamento @relation(fields: [id_departamento], references: [id])

  @@unique([id_departamento, id_local_ext, fecha])
  @@map("cumplimiento_diario")
}

// --- Seguimiento de un Pago puntual de dcsmart (deliberadamente FUERA del
// modelo Tarea/TareaAsignacion/Calendar). Un pago es un registro de una sola
// vez de OTRO sistema, no algo que se repita -- forzarlo por el motor de
// agenda (RRULE, horizonte de 12 meses, evento de Calendar) seria mezclar dos
// formas de "tarea" que no son lo mismo, y ensuciaria el calendario del
// departamento con eventos que no son operativos reales. Esta tabla es la
// unica fuente de verdad de "quien tiene que hacer algo con este pago" -- no
// hay evento de Calendar equivalente.
//
// id_pago referencia Pago.id de dcsmart, leido via BigQuery (CDC), NUNCA
// escrito -- por eso no es una FK real (dcsmart vive en otra base). El resto
// de los campos de "identidad" del pago (proveedor/importe/fecha/comprobante)
// se guardan en SNAPSHOT al vincular, para que listar "mis pagos" no dependa
// de una llamada a BigQuery por fila, y para que quede registrado como se
// veia el pago en el momento en que se marco para seguimiento. ---
model PagoSeguimiento {
  id           String    @id @default(uuid())
  id_pago      String    @unique
  id_local_ext String?
  comprobante  String?
  proveedor    String?
  importe      Decimal?  @db.Decimal(12, 2)
  fecha_pago   DateTime? @db.Date

  // "Tarea y/o usuario" -- los dos son independientes y opcionales: se puede
  // clasificar con una tarea del catalogo sin asignarsela a nadie todavia, o
  // asignarla a alguien sin clasificarla.
  id_tarea   String?
  asignado_a String?
  nota       String?
  estado     String   @default("PENDIENTE") // PENDIENTE | HECHO
  created_by String
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  tarea Tarea? @relation(fields: [id_tarea], references: [id])

  @@index([asignado_a, estado])
  @@map("pago_seguimientos")
}
