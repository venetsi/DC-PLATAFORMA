generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// --- Cache de identidad de dcsmart (nunca fuente de verdad) ---

model ExtUser {
  id              String   @id
  email           String   @unique
  nombre          String
  id_departamento String?
  // Rol global super_admin/dcsmart, resuelto desde el ticket SSO (Fase 8).
  // Reemplaza el hardcode por email que usaba el login temporal de dev.
  es_admin_global Boolean  @default(false)
  activo          Boolean  @default(true)
  synced_at       DateTime @default(now())

  @@map("ext_users")
}

model ExtLocal {
  id        String   @id
  nombre    String
  grupo     String?
  activo    Boolean  @default(true)
  synced_at DateTime @default(now())

  asignaciones TareaAsignacion[]

  @@map("ext_locales")
}

// --- Cache del catálogo Departamento de dcsmart + configuración propia
// (Calendar/Group/Chat/kiosko) que no tiene sentido guardar en dcsmart. ---

model Departamento {
  id                 String   @id
  nombre             String
  slug               String   @unique
  id_calendar_google String?  @unique
  email_group_google String?  @unique
  chat_webhook_url   String?
  kiosko_key         String?  @unique
  activo             Boolean  @default(true)
  synced_at          DateTime @default(now())

  tareas                   Tarea[]
  cumplimiento             CumplimientoDiario[]
  asignaciones_compartidas TareaAsignacionDepto[]

  @@map("departamentos")
}

// --- Catálogo de tipos de tarea ("TAREA -> DEPARTAMENTO" del ejemplo real) ---

model Tarea {
  id              String   @id @default(uuid())
  id_departamento String
  nombre          String   @unique
  descripcion     String?
  activa          Boolean  @default(true)
  created_at      DateTime @default(now())
  updated_at      DateTime @updatedAt

  departamento Departamento      @relation(fields: [id_departamento], references: [id])
  asignaciones TareaAsignacion[]

  @@index([id_departamento, activa])
  @@map("tareas")
}

// --- Puntero tarea x local hacia Google Calendar. No guarda recurrencia ni
// estado -- eso vive 100% en el evento de Calendar. Existe solo para: (a)
// saber que combinaciones (tarea, local) estan planeadas aunque todavia no
// tengan agenda definida, y (b) resolver id_tarea/id_local_ext -> evento. ---

model TareaAsignacion {
  id                String   @id @default(uuid())
  id_tarea          String
  id_local_ext      String?
  id_calendar_event String?
  activa            Boolean  @default(true)
  created_at        DateTime @default(now())
  updated_at        DateTime @updatedAt

  tarea       Tarea                  @relation(fields: [id_tarea], references: [id])
  local       ExtLocal?              @relation(fields: [id_local_ext], references: [id])
  compartidas TareaAsignacionDepto[]

  // OJO: @@unique de abajo NO alcanza para alcance EMPRESA (id_local_ext
  // NULL) -- Postgres no trata dos NULL como iguales, asi que dos filas con
  // el mismo id_tarea y ambas NULL pasan el chequeo de Prisma pero NO
  // deberian existir. Confirmado como bug real: creo 3 asignaciones
  // "CMV sin local" duplicadas durante pruebas manuales. El indice unico
  // parcial que lo cierra de verdad esta agregado a mano en la migracion
  // (Prisma no puede expresar "WHERE id_local_ext IS NULL" en el schema):
  //   CREATE UNIQUE INDEX ux_tarea_asignaciones_empresa
  //     ON tarea_asignaciones (id_tarea) WHERE id_local_ext IS NULL;
  //   CREATE UNIQUE INDEX ux_tarea_asignaciones_local
  //     ON tarea_asignaciones (id_tarea, id_local_ext) WHERE id_local_ext IS NOT NULL;
  @@unique([id_tarea, id_local_ext])
  @@index([id_local_ext])
  @@map("tarea_asignaciones")
}

// --- Comparte una TareaAsignacion con departamento(s) adicionales, ademas
// del dueño de la Tarea (tarea.id_departamento). "Un solo evento visible
// para ambos deptos": mismo id_asignacion (el extendedProperty que ya
// enlaza estado en Calendar), pero cada Calendar necesita su propia copia
// fisica del evento porque un evento vive en un unico calendario -- por eso
// cada fila guarda su propio id_calendar_event. Marcar realizada/editar
// agenda/desactivar/eliminar se propaga a todas las filas de esta tabla
// ademas de la TareaAsignacion original, ver asignaciones.js. ---
model TareaAsignacionDepto {
  id                String   @id @default(uuid())
  id_asignacion     String
  id_departamento   String
  id_calendar_event String?
  created_at        DateTime @default(now())

  asignacion   TareaAsignacion @relation(fields: [id_asignacion], references: [id])
  departamento Departamento    @relation(fields: [id_departamento], references: [id])

  @@unique([id_asignacion, id_departamento])
  @@map("tarea_asignacion_deptos")
}

model CumplimientoDiario {
  id                 String   @id @default(uuid())
  id_departamento    String
  // String vacio (no null) = fila agregada de todo el departamento. A
  // proposito NO nullable: Postgres no trata dos NULL como iguales en el
  // indice unico de abajo, asi que un NULL real dejaria que upsert() inserte
  // duplicados en vez de actualizar la fila existente en cada corrida del job.
  id_local_ext       String   @default("")
  fecha              DateTime @db.Date
  total_tareas       Int
  realizadas         Int
  vencidas_sin_hacer Int
  created_at         DateTime @default(now())

  departamento Departamento @relation(fields: [id_departamento], references: [id])

  @@unique([id_departamento, id_local_ext, fecha])
  @@map("cumplimiento_diario")
}
